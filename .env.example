APP_NAME=tech-career-platform
ENVIRONMENT=development

# Optional overrides. These defaults match the dev container setup.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/platform_dev
DB_ECHO=false

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Auth — change this to a long random string in production
JWT_SECRET=reallysecuresecret-dev-default-key
JWT_ALGORITHM=HS256

# CORS
ALLOWED_ORIGINS=["http://localhost:4200"]

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini